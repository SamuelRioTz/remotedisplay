<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>app.remotedisplay.server</string>
    <key>CFBundleExecutable</key>
    <string>RemoteDisplayServer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleName</key>
    <string>Remote Display Server</string>
    <key>CFBundleDisplayName</key>
    <string>Remote Display Server</string>
    <!-- Only CFBundleIconFile (classic icns). CFBundleIconName is for asset
         catalog icons (Assets.car), which this bundle does NOT have: on macOS 26 that
         key made System Settings render the icon as pixel noise. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>CFBundleVersion</key>
    <string>6</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.5</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Remote Display Server answers discovery from clients on your local network and accepts their direct connections.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Samuel Rioja. Licensed under AGPL-3.0. Based on RustDesk.</string>
</dict>
</plist>
